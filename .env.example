# Copy to .env and fill in real values. .env is gitignored.

# Supabase project URL (without /rest/v1).
SUPABASE_URL=https://your-project.supabase.co

# Server-side secret key. Never expose this to the browser.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Optional shared secret for POST /presets/{slug}/recompute.
ADMIN_TOKEN=replace_me

# Comma-separated list of allowed browser origins. Use * for local testing.
CORS_ORIGINS=*
